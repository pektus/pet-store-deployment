# ==============================================================================
# Pet Store Docker Compose Environment Configuration
# Copy this file to .env on the server to override any defaults:
# cp .env.example .env
# ==============================================================================

# Application Version Tag (used for Docker image tags)
APP_VERSION=latest

# Host Port (Default: 80 for browsing http://192.168.1.235)
HOST_PORT=80

# PostgreSQL Configuration
POSTGRES_DB=petstoredb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring Security JWT Secret (256-bit hexadecimal string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
